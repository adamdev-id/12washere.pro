[Unit]
Description=12WASHERE public donation updates
After=network.target

[Service]
User=12washere-donations
Group=12washere-donations
EnvironmentFile=/etc/12washere-donations.env
ExecStart=/usr/bin/python3 /opt/12washere-donations/donation-service.py --db /var/lib/12washere-donations/state.sqlite3 --seed /opt/12washere-donations/donation-status.json
Restart=on-failure
RestartSec=5
StateDirectory=12washere-donations
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryMax=96M
TasksMax=32
CPUQuota=20%

[Install]
WantedBy=multi-user.target
